pipeline {
    agent any

    environment {
        // --- YOUR AZURE & ACR DETAILS ---
        AZURE_SUBSCRIPTION_ID = '8fbf56a2-fc1e-45d5-8dea-1adc237a62da'
        REGISTRY_NAME         = 'apexshieldacrdev.azurecr.io'
        IMAGE_NAME            = 'spring-petclinic'
        IMAGE_TAG             = "${BUILD_NUMBER}"
        AKS_RESOURCE_GROUP    = 'rg-apexshield-dev'
        AKS_CLUSTER_NAME      = 'aks-apexshield-dev'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir('spring-petclinic') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('spring-petclinic') {
                    withSonarQubeEnv('sonarqube-servers') {
                        sh './mvnw org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('spring-petclinic') {
                    sh "docker build -t ${REGISTRY_NAME}/${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker tag ${REGISTRY_NAME}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY_NAME}/${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh "trivy image --severity HIGH,CRITICAL ${REGISTRY_NAME}/${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }

        stage('Push Image to ACR') {
            steps {
                withCredentials([azureServicePrincipal('azure-sp-credentials')]) {
                    sh '''
                        # 1. Login to Azure CLI using Service Principal credentials
                        az login --service-principal \
                          -u "$AZURE_CLIENT_ID" \
                          -p "$AZURE_CLIENT_SECRET" \
                          --tenant "$AZURE_TENANT_ID"

                        # 2. Authenticate to Azure Container Registry
                        az acr login --name apexshieldacrdev

                        # 3. Push Docker Images
                        docker push ${REGISTRY_NAME}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${REGISTRY_NAME}/${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('Deploy to AKS') {
    steps {
        withCredentials([azureServicePrincipal('azure-sp-credentials')]) {
            sh '''
                # 1. Login to Azure CLI
                az login --service-principal \
                  -u "$AZURE_CLIENT_ID" \
                  -p "$AZURE_CLIENT_SECRET" \
                  --tenant "$AZURE_TENANT_ID"

                # 2. Connect to AKS and Deploy
                az aks get-credentials --resource-group ${AKS_RESOURCE_GROUP} --name ${AKS_CLUSTER_NAME} --overwrite-existing
                kubectl apply -f k8s/deployment.yaml
                kubectl set image deployment/spring-petclinic spring-petclinic=${REGISTRY_NAME}/${IMAGE_NAME}:${IMAGE_TAG}
            '''
        }
    }
}
    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully! Deployed image tag ${IMAGE_TAG} to AKS."
        }
        failure {
            echo "Pipeline failed. Check build logs."
        }
    }
}