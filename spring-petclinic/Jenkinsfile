pipeline {
    agent any

    tools {
        maven 'maven-3'
        jdk 'jdk-21'
    }

    environment {
        REGISTRY = 'apexshieldacrdev.azurecr.io'
        IMAGE_NAME = 'spring-petclinic'
        ACR_CREDENTIALS = credentials('acr-credentials')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir('spring-petclinic') {
                    // Skips docker-compose integration tests that fail inside Jenkins VM
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube Code Analysis...'
                // Add your SonarQube scanner command here if configured
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER} -t ${REGISTRY}/${IMAGE_NAME}:latest ./spring-petclinic"
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                echo 'Running Trivy Vulnerability Scan...'
                // sh "trivy image ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"
            }
        }

        stage('Push Image to ACR') {
            steps {
                script {
                    sh "echo ${ACR_CREDENTIALS_PSW} | docker login ${REGISTRY} -u ${ACR_CREDENTIALS_USR} --password-stdin"
                    sh "docker push ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"
                    sh "docker push ${REGISTRY}/${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Deploy to AKS') {
            steps {
                script {
                    sh "sed -i 's/BUILD_NUMBER/${BUILD_NUMBER}/g' k8s/petclinic.yml"
                    sh "kubectl apply -f k8s/petclinic.yml"
                }
            }
        }
    }

    post {
        always {
            sh "docker logout ${REGISTRY} || true"
            cleanWs()
        }
    }
}